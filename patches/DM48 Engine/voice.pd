#X obj 20 355 r eng-release;
#X obj 20 440 t f f;
#X msg 20 470 0 \$1;
#X obj 110 470 + 50;
#X obj 110 500 delay 200;
#X msg 110 530 0;
#X obj 410 780 f 0;
#X obj 410 805 s \$0-act;
