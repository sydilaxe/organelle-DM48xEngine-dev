#N canvas 50 50 1200 900 10;
#X text 20 5 Host voice. Input from [poly]: 'key vel' \, key = channel * 128 + note.;
#X text 20 22 Internal channels: 17 * loop layer + MIDI channel (0 = Organelle keys). Master = 17 * layer + 1.;
#X obj 20 50 inlet;
#X obj 20 75 unpack 0 0;
#X obj 20 125 f;
#X obj 110 100 t b f;
#X obj 160 125 expr int(\$f1 / 128) \; \$f1 % 128;
#X obj 20 150 sel 0;
#X obj 20 840 s \$0-pitch;
#X obj 150 840 s \$0-level;
#X obj 280 840 s \$0-timbre;
#X obj 80 180 t b f b;
#X msg 160 210 1;
#X msg 200 210 stop;
#X msg 250 210 0.5 0;
#X obj 80 240 expr pow(\$f1 / 127 \, \$f2);
#X obj 220 240 r eng-curve;
#X msg 80 270 \$1 4;
#X obj 20 270 f;
#X obj 20 300 expr \$f2 + \$f3 + engbend[\$f1] + (\$f1 != 17 * int(\$f1 / 17) + 1) * engbend[17 * int(\$f1 / 17) + 1] + engjust[(\$f2 - \$f4 + 120) % 12];
#X msg 20 330 \$1 0;
#X obj 20 380 t b b;
#X msg 120 410 0;
#X obj 20 410 f 200;
#X obj 20 355 r eng-release;
#X obj 20 440 t f f;
#X msg 20 470 0 \$1;
#X obj 110 470 + 50;
#X obj 110 500 delay 200;
#X msg 110 530 0;
#X obj 410 780 f 0;
#X obj 410 805 s \$0-act;
#X obj 450 50 r eng-bend;
#X obj 450 75 expr (\$f1 == \$f2) || (\$f1 == 17 * int(\$f2 / 17) + 1);
#X obj 450 100 sel 1;
#X obj 450 125 f;
#X obj 450 150 expr \$f2 + \$f3 + engbend[\$f1] + (\$f1 != 17 * int(\$f1 / 17) + 1) * engbend[17 * int(\$f1 / 17) + 1] + engjust[(\$f2 - \$f4 + 120) % 12];
#X msg 450 175 \$1 5;
#X obj 1000 125 r eng-octave;
#X obj 1100 125 r eng-key;
#X obj 450 230 r eng-breath;
#X obj 450 255 expr if((\$f1 == \$f4) && ((\$f2 < 0) || (\$f2 == \$f5)) && \$f6 \, \$f3 \, -1);
#X obj 450 280 moses 0;
#X msg 510 305 \$1 15;
#X obj 450 350 r eng-timbre;
#X obj 450 375 expr if((\$f1 == \$f3) && \$f4 \, \$f2 \, -1);
#X obj 450 400 moses 0;
#X msg 510 425 \$1 20;
#X obj 700 450 r eng-clear;
#X obj 700 475 f \$0;
#X msg 700 500  \; pd-\$1-eng clear;
#X obj 900 450 r eng-add;
#X obj 900 475 t a b;
#X obj 1000 500 f \$0;
#X obj 900 525 list prepend;
#X msg 900 550  \; pd-\$1-eng obj 10 10 ehost \$1 \$3 \$2;
#N canvas 50 50 500 300 $0-eng 0;
#X restore 700 600 pd $0-eng;
#X obj 20 870 catch~ \$0-out;
#X obj 20 895 outlet~;
