#X obj 300 400 expr if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && ((abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) < engsbd) \, (abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) \, engsbd) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && ((abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) < engsbd) \, engpbuf[\$f1] \, engsbp) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && (engpbuft[\$f1] > engslt) \, engpbuft[\$f1] \, engslt) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && (engpbuft[\$f1] > engslt) \, engpbuf[\$f1] \, engslp);
