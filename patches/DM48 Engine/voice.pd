#N canvas 50 50 1200 900 10;
#X text 20 5 Host voice. Input from [poly]: 'key vel' \, key = channel * 128 + note.;
#X text 20 22 Internal channels: 17 * loop layer + MIDI channel (0 = Organelle keys). Master = 17 * layer + 1.;
#X obj 20 50 inlet;
#X obj 20 75 unpack 0 0;
#X obj 20 125 f;
#X obj 110 100 t b f;
#X obj 160 125 expr int(\$f1 / 128) \; \$f1 % 128;
#X obj 20 150 sel 0;
#X obj 20 137 moses 0;
#X obj 20 840 s \$0-pitch;
#X obj 150 840 s \$0-level;
#X obj 280 840 s \$0-timbre;
#X obj 80 180 t b f b;
#X msg 160 210 1;
#X msg 200 210 stop;
#X msg 250 210 0.5 0;
#X obj 80 240 expr pow(\$f1 / 127 \, \$f2);
#X obj 220 240 r eng-curve;
#X msg 80 270 \$1 4;
#X obj 20 270 f;
#X obj 20 300 expr \$f2 + \$f3 + engbend[\$f1] + (\$f1 != 17 * int(\$f1 / 17) + 1) * engbend[17 * int(\$f1 / 17) + 1] + engjust[(\$f2 - \$f4 + 120) % 12];
#X obj 20 315 t f f f;
#X obj 700 300 timer;
#X obj 700 275 loadbang;
#X obj 300 300 t b b b f;
#X obj 400 325 v engsP;
#X obj 700 325 v engnow;
#X msg 480 325 1000000000.0;
#X obj 480 350 v engsbd;
#X msg 540 325 -1;
#X obj 540 350 v engsbp;
#X msg 600 325 -1;
#X obj 600 350 v engslt;
#X msg 660 325 -1;
#X obj 660 350 v engslp;
#X obj 300 350 until;
#X msg 300 325 16;
#X obj 300 375 f;
#X obj 340 375 + 1;
#X msg 360 325 0;
#X obj 300 400 expr if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && ((abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) < engsbd) \, (abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) \, engsbd) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && ((abs(engpbuf[\$f1] - engsP) + (engnow - engpbuft[\$f1]) / 1000) < engsbd) \, engpbuf[\$f1] \, engsbp) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && (engpbuft[\$f1] > engslt) \, engpbuft[\$f1] \, engslt) \; if(((engpbuft[\$f1] > 0) && (engnow - engpbuft[\$f1] > 30) && (engnow - engpbuft[\$f1] < 20000) && ((enggwhen == 0) || (engpbufh[\$f1] > 0))) && (engpbuft[\$f1] > engslt) \, engpbuf[\$f1] \, engslp);
#X obj 300 425 v engsbd;
#X obj 370 425 v engsbp;
#X obj 440 425 v engslt;
#X obj 510 425 v engslp;
#X obj 20 365 expr if(enggfrom \, engslp \, engsbp) >= 0 && (engglide > 0) \; if(enggfrom \, engslp \, engsbp) \; \$f1;
#X obj 20 390 pack 0 0 0;
#X obj 20 415 route 0 1;
#X msg 20 440 \$2 0;
#X obj 120 440 expr \$f1 \; \$f2 \; engglide;
#X obj 120 465 pack 0 0 0;
#X msg 120 490 \$1 0 \, \$2 \$3;
#X obj 300 515 timer;
#X obj 300 540 expr max(5 \, \$f2 - \$f1);
#X obj 200 515 expr \$f1 * engglide;
#X obj 20 540 t f b b;
#X obj 100 615 f -1;
#X obj 100 565 expr engpidx \; (engpidx + 1) % 16;
#X obj 220 590 v engpidx;
#X obj 220 640 f -1;
#X obj 100 590 t f f f;
#X obj 300 640 tabwrite engpbufh;
#X obj 300 615 expr 1;
#X obj 420 640 tabwrite engpbuft;
#X obj 420 615 expr engnow;
#X obj 20 640 tabwrite engpbuf;
#X obj 20 615 v englastp;
#X obj 20 380 t b b;
#X obj 160 690 t b f;
#X obj 160 740 tabwrite engpbufh;
#X msg 160 715 0;
#X msg 120 410 0;
