#N canvas 50 50 900 520 10;
#X text 20 5 One engine in one voice. Runs (switch~) only while it is the selected engine (eng-esel) and the voice sounds. Selected: waits 15 ms (the old engine fades out) \, then fades in over 15 ms.;
#X obj 20 40 r \$1-pitch;
#X obj 120 40 r \$1-level;
#X obj 220 40 r \$1-timbre;
#X obj 20 90 \$2 eng;
#X obj 20 140 *~;
#X obj 120 115 line~;
#X obj 20 170 throw~ \$1-out;
#X obj 400 340 f 0;
#X obj 450 340 f 0;
#X obj 500 340 f 0;
#X obj 400 315 t b b b;
#X obj 400 390 expr \$f1 && (\$f2 || \$f3);
#X obj 400 415 switch~;
#X obj 400 65 t b f;
#X obj 400 40 r \$1-act;
#X obj 550 40 == \$3;
#X obj 550 15 r eng-esel;
#X obj 550 65 change -1;
#X obj 550 90 t b f f;
#X obj 550 115 sel 1 0;
#X obj 550 140 t b b b;
#X obj 750 190 delay 20;
#X msg 650 165 stop;
#X msg 600 165 0;
#X obj 550 190 delay 15;
#X msg 550 215 1 15;
#X obj 750 140 t b b;
#X msg 800 165 1;
#X msg 850 165 0 15;
#X obj 750 215 t b b;
#X msg 800 240 0;
