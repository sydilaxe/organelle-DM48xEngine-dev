#X obj 20 90 +~;
#X obj 20 115 mtof~;
#X obj 20 140 clip~ 1 20000;
#X obj 120 165 r~ mpe-sawk;
#X obj 120 190 /~;
#X obj 260 140 r~ mpe-detune;
#X obj 260 165 *~;
