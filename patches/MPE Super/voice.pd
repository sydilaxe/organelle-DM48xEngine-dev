#N canvas 50 50 1100 760 10;
#X text 20 10 One voice. Gets 'key vel' from [poly] where key = channel*128 + note.;
#X text 20 28 Follows bend / breath / timbre sent on its own MIDI channel.;
#X obj 20 60 inlet;
#X obj 20 86 unpack 0 0;
#X obj 20 140 f;
#X obj 110 140 t b f;
#X obj 160 170 expr int(\$f1/128) \; \$f1 % 128;
#X obj 20 200 sel 0;
#X obj 80 240 t b f b;
#X msg 160 270 1;
#X msg 200 270 stop;
#X msg 250 270 0.5;
#X obj 80 300 expr pow(\$f1/127 \, \$f2);
#X obj 200 300 r mpe-curve;
#X msg 80 330 \$1 4;
#X obj 20 330 f;
#X obj 20 360 expr \$f2 + \$f3 + mpebend[\$f1] + (\$f1 != 1) * mpebend[1];
#X obj 20 420 t b b;
#X msg 120 450 0;
#X obj 20 450 f 300;
#X obj 20 395 r mpe-release;
#X obj 20 480 t f f;
#X msg 20 510 0 \$1;
#X obj 110 510 + 40;
#X obj 110 570 delay 300;
#X msg 110 600 0;
#X obj 400 60 r mpe-bend;
#X obj 400 90 expr (\$f1 == \$f2) || (\$f1 == 1);
#X obj 400 120 sel 1;
#X obj 400 150 f;
#X obj 400 180 expr \$f2 + \$f3 + mpebend[\$f1] + (\$f1 != 1) * mpebend[1];
#X msg 400 210 \$1 5;
#X obj 700 150 r mpe-octave;
#X obj 400 270 r mpe-breath;
#X obj 400 300 expr if((\$f1 == \$f4) && ((\$f2 < 0) || (\$f2 == \$f5)) && \$f6 \, \$f3 \, -1);
#X obj 400 330 moses 0;
#X msg 460 360 \$1 15;
#X obj 400 420 r mpe-timbre;
#X obj 400 450 expr if((\$f1 == \$f3) && \$f4 \, \$f2 \, -1);
#X obj 400 480 moses 0;
#X msg 460 510 \$1 20;
#N canvas 50 50 1100 800 dsp 0;
#X obj 20 20 inlet;
#X obj 400 20 inlet;
#X obj 650 20 inlet;
#X obj 900 20 inlet;
#X obj 900 60 switch~;
#X obj 20 60 line~;
